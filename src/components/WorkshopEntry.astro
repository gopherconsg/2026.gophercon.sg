---
import { Image } from "astro:assets";
import { type ImageMap, findSpeakerImage } from "@/lib/images";
import type { Workshop } from "@/types";
import { Icon } from "astro-icon/components";
import { marked } from "marked";

interface Props {
  workshop: Workshop;
  speakerImageMap: ImageMap;
}

const { workshop, speakerImageMap } = Astro.props;

// Split description at first h4 heading for progressive disclosure
const h4Index = workshop.description.indexOf("\n####");
const hasSyllabus = h4Index > 0;
const overviewMd = hasSyllabus
  ? workshop.description.substring(0, h4Index).trim()
  : workshop.description;
const syllabusMd = hasSyllabus
  ? workshop.description.substring(h4Index).trim()
  : "";

const overviewHtml = marked.parse(overviewMd);
const syllabusHtml = hasSyllabus ? marked.parse(syllabusMd) : "";
const speakerBioHtml = marked.parse(workshop.speakerBio);
const prerequisitesHtml = workshop.prerequisites
  ? marked.parse(workshop.prerequisites)
  : "";
const venueHtml = marked.parse(workshop.venue);

const speakerImg = findSpeakerImage(speakerImageMap, workshop.speakerImage);
---

<article id={workshop.id} class="workshop-card">
  <div class="workshop-card-header">
    <div class="workshop-card-photo">
      {speakerImg ? (
        <Image
          src={speakerImg}
          alt={workshop.speaker}
          width={80}
          height={80}
          style="width: 100%; height: 100%; object-fit: cover;"
        />
      ) : (
        <div class="workshop-card-photo-fallback">
          {workshop.speaker.charAt(0)}
        </div>
      )}
    </div>
    <div class="workshop-card-meta">
      <h2 class="workshop-card-title">
        {workshop.title}
        <span class="copy-link-wrapper" style="vertical-align: middle;">
          <button
            type="button"
            class="copy-link"
            data-href={`/workshops#${workshop.id}`}
            aria-label="Copy link to this workshop"
          >
            <Icon name="fa:link" class="w-3.5 h-3.5" />
          </button>
          <span class="copy-link-tooltip" aria-live="polite">Copied!</span>
        </span>
      </h2>
      <div class="workshop-card-instructor">
        by{" "}
        <a href={workshop.speakerLink}>{workshop.speaker}</a>
        {workshop.speakerSocialUrl && (
          <a
            href={workshop.speakerSocialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="workshop-card-social"
          >
            <Icon name="fa:twitter" class="w-3.5 h-3.5" />
          </a>
        )}
      </div>
      <div class="workshop-card-datetime">
        <span><Icon name="fa:calendar" class="w-3.5 h-3.5" />{workshop.date}</span>
        <span><Icon name="fa:clock-o" class="w-3.5 h-3.5" />{workshop.time}</span>
      </div>
    </div>
  </div>

  <div class="workshop-card-body">
    <div class="workshop-card-overview" set:html={overviewHtml} />

    {syllabusHtml && (
      <details class="workshop-details">
        <summary>Full Curriculum</summary>
        <div class="workshop-details-content" set:html={syllabusHtml} />
      </details>
    )}

    {prerequisitesHtml && (
      <div class="prerequisites-callout">
        <h4 style="margin-top: 0;">Prerequisites</h4>
        <div set:html={prerequisitesHtml} />
      </div>
    )}

    <details class="workshop-details">
      <summary>About the Instructor</summary>
      <div class="workshop-details-content">
        <div class="workshop-instructor-bio">
          {speakerImg && (
            <div class="workshop-instructor-photo">
              <Image
                src={speakerImg}
                alt={workshop.speaker}
                width={120}
                height={120}
                style="width: 100%; height: 100%; object-fit: cover;"
              />
            </div>
          )}
          <div set:html={speakerBioHtml} />
        </div>
      </div>
    </details>

    <div class="workshop-card-footer">
      <div class="workshop-card-venue">
        <Icon name="fa:map-marker" class="w-4 h-4" style="color: var(--color-brand-red); flex-shrink: 0;" />
        <div set:html={venueHtml} />
      </div>
      {workshop.venueRegistration && (
        <p style="font-size: 0.875rem; color: #666; margin-bottom: 0;">({workshop.venueRegistration})</p>
      )}
      {workshop.venueMapUrl && (
        <a
          href={workshop.venueMapUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="font-size: 0.875rem; color: var(--color-link-blue);"
        >
          View on map →
        </a>
      )}
      {workshop.additional && (
        <p class="workshop-card-additional">
          <Icon name="fa:info-circle" class="w-4 h-4" style="color: var(--color-brand-blue); flex-shrink: 0;" />
          {workshop.additional}
        </p>
      )}
    </div>
  </div>
</article>
