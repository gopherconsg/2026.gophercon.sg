---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { marked } from "marked";
import { resolveSpeakerImage, type ImageMap } from "@/lib/images";
import type { Speaker } from "@/types";

interface Props {
  speaker: Speaker;
  imageMap: ImageMap;
}

const { speaker, imageMap } = Astro.props;
const descriptionHtml = marked.parse(speaker.description);
---

<div id={speaker.id} style="scroll-margin-top: 5rem; padding: 2rem 0; border-bottom: 1px solid #eee;">
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <div style="display: flex; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap;">
      <div style="width: 170px; height: 170px; border-radius: 50%; overflow: hidden; flex-shrink: 0;">
        <Image
          src={resolveSpeakerImage(imageMap, speaker.image)}
          alt={speaker.name}
          width={170}
          height={170}
          style="width: 100%; height: 100%; object-fit: cover;"
        />
      </div>

      <div style="flex: 1; min-width: 200px;">
        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.25rem;">
          <h2 style="font-size: 1.5rem; margin-bottom: 0;">{speaker.name}</h2>
          {speaker.keynote && (
            <span style="background: var(--color-brand-red); color: #fff; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-weight: 600; text-transform: uppercase;">
              Keynote
            </span>
          )}
          <span class="copy-link-wrapper">
            <button
              class="copy-link"
              data-href={`/speakers#${speaker.id}`}
              aria-label="Copy link to this speaker"
            >
              <Icon name="fa:link" class="w-4 h-4" />
            </button>
            <span class="copy-link-tooltip" aria-live="polite">Copied!</span>
          </span>
        </div>

        {speaker.company && (
          <p style="color: #666; margin-bottom: 0.5rem;">{speaker.company}</p>
        )}

        {speaker.socialUrl && (
          <a
            href={speaker.socialUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="display: inline-flex; align-items: center; gap: 0.25rem; color: var(--color-link-blue); font-size: 0.875rem; margin-bottom: 0.5rem;"
          >
            <Icon name="fa:twitter" class="w-4 h-4" />
            Twitter
          </a>
        )}

        <div set:html={descriptionHtml} style="margin-top: 0.5rem;" />

        <p style="margin-top: 0.5rem; margin-bottom: 0;">
          <strong>Talk:</strong>{' '}
          <a href={speaker.topicLink} style="color: var(--color-link-blue);">
            {speaker.topicTitle}
          </a>
        </p>
      </div>
    </div>
  </div>
</div>
