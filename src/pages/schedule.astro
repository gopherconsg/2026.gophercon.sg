---
import ScheduleEntry from "../components/ScheduleEntry.astro";
import Timeline from "../components/Timeline.astro";
import { siteConfig } from "../config";
import contentRaw from "../data/content.toml";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ContentData, ScheduleEntry as ScheduleEntryType } from "../types";
const content = contentRaw as unknown as ContentData;
const footerConfig = content.footer;
const ticketsConfig = content.tickets;
import scheduleRaw from "../data/schedule.toml";

const scheduleData = scheduleRaw as unknown as {
  schedule: ScheduleEntryType[];
};
const schedule = scheduleData.schedule ?? [];
const isArchived = siteConfig.eventStatus === "archived";
const isLive = siteConfig.eventStatus === "live";

const speakerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/speakers/*.{jpg,jpeg,webp,png}",
  { eager: true },
);
---

<BaseLayout
  title="Schedule"
  description="Conference schedule for GopherCon Singapore 2026"
>
  <div class="page-bg">
    <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
      <h1 style="font-family: var(--font-heading); margin-bottom: 2rem;">Schedule</h1>

      {schedule.length > 0 ? (
        <Timeline>
          {schedule.map((entry) => (
            <ScheduleEntry entry={entry} imageMap={speakerImages} />
          ))}
        </Timeline>
      ) : (
        <p style="color: #666;">
          Schedule coming soon. Follow us on{' '}
          <a href={footerConfig.twitterURL} target="_blank" rel="noopener noreferrer">
            Twitter
          </a>{' '}
          for updates.
        </p>
      )}

      {isLive && (
        <div style="text-align: center; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #eee;">
          <p style="font-size: 1.1rem;">
            Ready to join us?{' '}
            <a href={ticketsConfig.link} style="color: var(--color-link-blue); font-weight: 600;">
              Get your ticket →
            </a>
          </p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
