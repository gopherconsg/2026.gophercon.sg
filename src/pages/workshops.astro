---
import Timeline from "../components/Timeline.astro";
import WorkshopEntry from "../components/WorkshopEntry.astro";
import { siteConfig } from "../config";
import contentRaw from "../data/content.toml";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ContentData, Workshop } from "../types";
const content = contentRaw as unknown as ContentData;
const footerConfig = content.footer;
const ticketsConfig = content.tickets;
import workshopRaw from "../data/workshops.toml";

const workshopData = workshopRaw as unknown as { workshops: Workshop[] };
const workshops = workshopData.workshops ?? [];
const isArchived = siteConfig.eventStatus === "archived";
const isLive = siteConfig.eventStatus === "live";

const speakerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/speakers/*.{jpg,jpeg,webp,png}",
  { eager: true },
);
---

<BaseLayout
  title="Workshops"
  description="Workshops at GopherCon Singapore 2026"
>
  <div class="page-bg">
    <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
      <h1 style="font-family: var(--font-heading); margin-bottom: 2rem;">
        {workshops.length > 0 ? `${workshops.length} Workshop${workshops.length !== 1 ? 's' : ''}` : 'Workshops'}
      </h1>

      {workshops.length > 0 ? (
        <Timeline>
          {workshops.map((workshop) => (
            <WorkshopEntry workshop={workshop} speakerImageMap={speakerImages} />
          ))}
        </Timeline>
      ) : (
        <p style="color: #666;">
          Workshop details coming soon. Follow us on{' '}
          <a href={footerConfig.twitterURL} target="_blank" rel="noopener noreferrer">
            Twitter
          </a>{' '}
          for updates.
        </p>
      )}

      {isLive && (
        <div style="text-align: center; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #eee;">
          <p style="font-size: 1.1rem;">
            Ready to join us?{' '}
            <a href={ticketsConfig.link} style="color: var(--color-link-blue); font-weight: 600;">
              Get your ticket →
            </a>
          </p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
